<configuration>
    <springProperty scope="context" name="logDays" source="retention.log-days" defaultValue="14"/>
    <property name="logDirectory" value="${LOG_DIR:-logs}"/>
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder><pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level %logger{36} correlation=%X{correlationId} - %msg%n</pattern></encoder>
    </appender>
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${logDirectory}/channel-connect.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${logDirectory}/channel-connect.%d{yyyy-MM-dd}.log</fileNamePattern>
            <maxHistory>${logDays}</maxHistory>
            <cleanHistoryOnStart>true</cleanHistoryOnStart>
        </rollingPolicy>
        <encoder><pattern>%d{yyyy-MM-dd'T'HH:mm:ss.SSSXXX} %-5level %logger{36} correlation=%X{correlationId} - %msg%n</pattern></encoder>
    </appender>
    <!-- RestClient DEBUG events include request bodies; keep them out of diagnostics. -->
    <logger name="org.springframework.web.client" level="INFO"/>
    <root level="INFO"><appender-ref ref="CONSOLE"/><appender-ref ref="FILE"/></root>
</configuration>
