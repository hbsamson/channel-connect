META_APP_SECRET=replace-with-meta-app-secret
META_VERIFY_TOKEN=replace-with-random-verification-token

# create a random verification token using PowerShell
$bytes = New-Object byte[] 32
$rng = [System.Security.Cryptography.RandomNumberGenerator]::Create()
$rng.GetBytes($bytes)
[BitConverter]::ToString($bytes).Replace("-", "").ToLower()
$rng.Dispose()

META_PAGE_ACCESS_TOKEN=replace-with-page-access-token
META_PAGE_ID=replace-with-page-id
META_GRAPH_API_VERSION=replace-with-current-graph-api-version
OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_MODEL=gpt-5-nano
# Includes reasoning tokens and visible text; increase if diagnostics show max_output_tokens.
OPENAI_MAX_OUTPUT_TOKENS=1024
# GPT-5 nano supports minimal. Leave blank to omit for models without reasoning support.
OPENAI_REASONING_EFFORT=minimal
# Recent user and successfully delivered assistant messages, including the current message.
OPENAI_HISTORY_LIMIT=20
OPENAI_ASSISTANT_INSTRUCTIONS=You are a helpful Messenger assistant. Use conversation history to remember user preferences. Reply naturally and concisely, usually in 1-3 sentences. Avoid long lists, introductions, generic filler, and unnecessary follow-up questions. Give detailed answers when explicitly requested.
# Optional: leave blank until documents are available.
OPENAI_VECTOR_STORE_ID=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-strong-password
# Required Meta WhatsApp Cloud API settings
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# Required by the local-only outbound template endpoint
OUTBOUND_LOCAL_AUTH_TOKEN=
# Comma-separated Meta-verified test recipients, digits only (no leading +)
OUTBOUND_ALLOWED_RECIPIENTS=
OUTBOUND_ALLOWED_TEMPLATES=hello_world

# Optional AI selection. The local profile defaults to mock.
AI_PROVIDER=mock

# Optional overrides
META_GRAPH_BASE_URL=https://graph.facebook.com
HTTP_CONNECT_TIMEOUT=3s
HTTP_READ_TIMEOUT=10s
WHATSAPP_OUTBOUND_MAX_ATTEMPTS=2
WHATSAPP_OUTBOUND_MAX_RETRY_DELAY=2s
WHATSAPP_WEBHOOK_MAX_REQUEST_BYTES=262144
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT=30s
OPENAI_MAX_RETRIES=2
AI_MAX_RESPONSE_CHARACTERS=4096
DISPATCH_WORKER_COUNT=4
DISPATCH_QUEUE_CAPACITY=100
DISPATCH_DEDUPLICATION_CAPACITY=10000
DISPATCH_DEDUPLICATION_TTL=24h
DISPATCH_SHUTDOWN_TIMEOUT=10s
OUTBOUND_IDEMPOTENCY_CAPACITY=1000
OUTBOUND_IDEMPOTENCY_TTL=24h
# Dealership demo: scripts/Start-Demo.ps1 loads .env explicitly; the application itself does not.
DEALERSHIP_NAME=Toyota Manila Bay
DEALERSHIP_CATALOG=classpath:dealership/catalog.json
DEALERSHIP_CAMPAIGN=classpath:campaigns/registration-renewal.json
DEALERSHIP_CUSTOMERS=classpath:dealership/customers.json
DEALERSHIP_PROMPT=classpath:prompts/dealership-assistant.md
DEALERSHIP_SCHEDULER_ENABLED=false
DEALERSHIP_HISTORY_LIMIT=20
DEALERSHIP_MAX_PROVIDER_FAILURES=3
