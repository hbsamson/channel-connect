META_APP_SECRET=replace-with-meta-app-secret
META_VERIFY_TOKEN=replace-with-random-verification-token

# create a random verification token using PowerShell
# $bytes = New-Object byte[] 32
# $rng = [System.Security.Cryptography.RandomNumberGenerator]::Create()
# $rng.GetBytes($bytes)
# [BitConverter]::ToString($bytes).Replace("-", "").ToLower()
# $rng.Dispose()

META_PAGE_ACCESS_TOKEN=replace-with-page-access-token
META_PAGE_ID=replace-with-page-id
META_GRAPH_API_VERSION=replace-with-current-graph-api-version
OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_MODEL=gpt-5-nano
# Includes reasoning tokens and visible text; increase if diagnostics show max_output_tokens.
OPENAI_MAX_OUTPUT_TOKENS=1024
# GPT-5 nano supports minimal. Leave blank to omit for models without reasoning support.
OPENAI_REASONING_EFFORT=minimal
MESSENGER_QUEUE_CAPACITY=100
MESSENGER_SHUTDOWN_TIMEOUT=10s
SHUTDOWN_PHASE_TIMEOUT=30s
# Rolling application log limits; LOG_DIR defaults to ./logs.
LOGGING_FILE_MAX_SIZE=10MB
LOGGING_FILE_TOTAL_SIZE_CAP=1GB
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-strong-password
# Required Meta WhatsApp Cloud API settings
WHATSAPP_PHONE_NUMBER_ID=
# Administrative WABA subscription commands in README.md; not used by the running connector.
WHATSAPP_WABA_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=

# Telegram webhook connector (disabled by default; use the local profile for in-memory dispatch).
# The local profile loads these from .env; elsewhere export them to the environment.
TELEGRAM_ENABLED=false
# Required when enabled: bot token obtained from BotFather.
TELEGRAM_BOT_TOKEN=
# Required when enabled: 1-256 letters, digits, underscores or hyphens.
# Pass the same value as secret_token when registering POST /webhooks/telegram.
TELEGRAM_WEBHOOK_SECRET_TOKEN=
TELEGRAM_CONNECT_TIMEOUT=3s
TELEGRAM_READ_TIMEOUT=10s
TELEGRAM_WEBHOOK_MAX_REQUEST_BYTES=262144
TELEGRAM_WORKER_COUNT=4
TELEGRAM_QUEUE_CAPACITY_PER_WORKER=25
TELEGRAM_DEDUPLICATION_CAPACITY=10000
TELEGRAM_DEDUPLICATION_TTL=24h
TELEGRAM_SHUTDOWN_TIMEOUT=10s
# Optional campaign-start API, available only with local/test and TELEGRAM_ENABLED=true.
TELEGRAM_CAMPAIGN_ENABLED=false
# Separate from the bot token and webhook secret: 32-256 letters, digits, underscores or hyphens.
TELEGRAM_CAMPAIGN_API_TOKEN=
# Exact private chat IDs, or chatId:topicId values, separated by commas.
TELEGRAM_CAMPAIGN_ALLOWED_RECIPIENTS=
# Approved dealership script keys. Append custom to enable free-text local/test demo sends.
# /api/v1/telegram/messages and /send require custom plus a verified, consenting linked chat.
TELEGRAM_CAMPAIGN_ALLOWED_SCRIPTS=opening,followup1,followup2,script1,script3
TELEGRAM_CAMPAIGN_IDEMPOTENCY_CAPACITY=1000
TELEGRAM_CAMPAIGN_IDEMPOTENCY_TTL=24h
# Reuses AI_PROVIDER and the existing AI configuration. No automatic webhook registration.
# Outside local/test, provide a durable TelegramInboundMessageDispatcher implementation.

# Required by the local-only outbound template endpoint
OUTBOUND_LOCAL_AUTH_TOKEN=
# Comma-separated Meta-verified test recipients, digits only (no leading +)
OUTBOUND_ALLOWED_RECIPIENTS=
OUTBOUND_ALLOWED_TEMPLATES=hello_world

# Optional AI selection. The local profile defaults to mock.
AI_PROVIDER=mock

# Optional overrides
META_GRAPH_BASE_URL=https://graph.facebook.com
HTTP_CONNECT_TIMEOUT=3s
HTTP_READ_TIMEOUT=10s
WHATSAPP_OUTBOUND_MAX_ATTEMPTS=2
WHATSAPP_OUTBOUND_MAX_RETRY_DELAY=2s
WHATSAPP_WEBHOOK_MAX_REQUEST_BYTES=262144
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT=30s
OPENAI_MAX_RETRIES=2
AI_MAX_RESPONSE_CHARACTERS=4096
DISPATCH_WORKER_COUNT=4
DISPATCH_QUEUE_CAPACITY=100
DISPATCH_DEDUPLICATION_CAPACITY=10000
DISPATCH_DEDUPLICATION_TTL=24h
DISPATCH_SHUTDOWN_TIMEOUT=10s
OUTBOUND_IDEMPOTENCY_CAPACITY=1000
OUTBOUND_IDEMPOTENCY_TTL=24h
# The local profile loads repository-root .env directly, including IntelliJ runs.
# Use unquoted KEY=value entries; backslashes follow Java properties escaping rules.
DEALERSHIP_NAME=Toyota Manila Bay
DEALERSHIP_CATALOG=classpath:dealership/catalog.json
DEALERSHIP_CAMPAIGN=classpath:campaigns/registration-renewal.json
DEALERSHIP_CUSTOMERS=classpath:dealership/customers.json
DEALERSHIP_PROMPT=classpath:prompts/dealership-assistant.md
DEALERSHIP_SCHEDULER_ENABLED=false
DEALERSHIP_HISTORY_LIMIT=20
DEALERSHIP_MAX_PROVIDER_FAILURES=3
## GoIP SMS (disabled by default; no physical endpoints or credentials are supplied here)
SMS_ENABLED=false
SMS_PROVIDER_MODE=MOCK
SMS_UDP_BIND_ADDRESS=127.0.0.1
SMS_UDP_PORT=0
SMS_LIVE_AUTHORIZED=false
# Set true for authorized HTTP, HTTP_API or LIVE gateway operation.
# Remove stale overrides from the IntelliJ run configuration when changing this.
SMS_API_TOKEN=
SMS_MOCK_AUTH_ID=
SMS_MOCK_PASSWORD=
SMS_MOCK_SIM_NUMBER=
SMS_REGISTRATION_TIMEOUT=90s
SMS_SESSION_TIMEOUT=80s
SMS_PACKET_TIMEOUT=3s
SMS_POLL_INTERVAL=3s
SMS_MAX_POLLS=10
SMS_MAX_SESSIONS=5
SMS_QUEUE_CAPACITY=1000
SMS_MAX_CONTENT_BYTES=3000
# The combined TMBG opening requires four segments. Direct UDP LIVE mode requires one.
SMS_MAX_SEGMENTS=4
SMS_PROCESSING_ATTEMPTS=3
SMS_PROCESSING_RETRY_DELAY=1s
SMS_QUEUE_EXPIRY=24h
SMS_CONTENT_RETENTION=30d
SMS_ID_RETENTION=90d
SMS_SHUTDOWN_TIMEOUT=10s
# Configure sms.channels externally with SPRING_APPLICATION_JSON or an external config file.
# Optional GoIP8 HTTP web form profile (local,demo,sms-http); keep real values outside source control.
SMS_GOIP_IPADDRESS=
SMS_GOIP_USER=
SMS_GOIP_PASS=
SMS_GOIP_TIMEOUT=60s
# Direct HTML inbox polling: local,sms-http-two-lines,sms-web-receive.
# Reuses SMS_GOIP_IPADDRESS, SMS_GOIP_USER and SMS_GOIP_PASS; no UDP credentials.
# SMS_POLL_INTERVAL controls continuous fetching; match the gateway's clock zone.
SMS_GOIP_WEB_INBOX_ZONE=Asia/Manila
SMS_GOIP_RECEIVE_ENABLED=false
# Use local,sms-http,sms-own-receive for the application's own receiver on SIM 1.
# Set SMS_GOIP_IPADDRESS, SMS_UDP_BIND_ADDRESS and a nonzero SMS_UDP_PORT.
SMS_GOIP_UDP_ID=
SMS_GOIP_UDP_PASSWORD=
# With local,sms-http-two-lines,sms-own-receive, both SIMs receive directly.
# SIM 2 must have a distinct SMS-server ID configured on the gateway.
SMS_GOIP_UDP_ID_2=
SMS_GOIP_UDP_PASSWORD_2=
# When enabled, set SMS_UDP_BIND_ADDRESS and a nonzero SMS_UDP_PORT, and configure
# sms.http-inbound.channels externally: account-id plus each SIM's UDP auth-id/password.
# UDP receive credentials are separate from SMS_GOIP_USER/SMS_GOIP_PASS.
# Hosted PHP sending profile: local,sms-http-api. Endpoint URLs omit query parameters.
# Legacy opt-in hosted inbox polling for HTTP or HTTP_API; disabled by default.
SMS_GOIP_API_RECEIVE_ENABLED=false
SMS_GOIP_API_SEND_URL=
SMS_GOIP_API_RECEIVE_URL=
SMS_GOIP_API_RECEIVE_KEY=
# Direct web mode: a nonempty device label shared by its SIMs.
# Hosted API mode: must instead match the JSON response's goip_id.
SMS_GOIP_GATEWAY_ID=goip8
SMS_GOIP_API_MAX_RESPONSE_BYTES=1048576
# Optional sms.http-api.receive-start-at in external config selects the first baseline.
# Entries: account-id, device-id, sim-channel, source-address, auth-id, password,
# optional sim-number, send-interval (default 5s), sends-per-hour (default 60),
# max-concurrent-sessions (default 1; live requires 1 until hardware verification).
